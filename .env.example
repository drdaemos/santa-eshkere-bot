# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Admin Telegram ID
# Get your Telegram user ID from @userinfobot
ADMIN_TELEGRAM_ID=your_telegram_id_here

# Database Configuration
# For local development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./db/santa_eshkere.db

# For production (PostgreSQL on Railway):
# DATABASE_URL will be automatically set by Railway if you add PostgreSQL plugin
# Or manually set it like: postgresql+asyncpg://user:pass@host:port/dbname

# Event Year
EVENT_YEAR=2024

# Webhook Configuration (for Railway deployment)
# Set to "true" when deploying to Railway
USE_WEBHOOK=false

# Railway will automatically provide these:
# WEBHOOK_URL=https://your-app.railway.app
# PORT=8000
