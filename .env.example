# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Local development: SQLite (file is created by `alembic upgrade head`)
DATABASE_URL=sqlite+aiosqlite:///./db/santa_eshkere.db
# Production (Railway sets this when you reference the Postgres service):
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# Webhook mode (Railway). Locally leave false to use polling.
USE_WEBHOOK=false
# WEBHOOK_URL=https://your-app.up.railway.app
# PORT=8000
# Optional: explicit webhook secret; by default it is derived from the bot token
# WEBHOOK_SECRET=

# Time zone joining deadlines are typed and shown in (IANA name)
# TIMEZONE=Europe/Moscow

# The bot owner's Telegram user id(s), comma-separated: admin rights in every group
# ADMIN_TELEGRAM_ID=
